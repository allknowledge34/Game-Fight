{
  "name": "sansad-showdown-reconstructed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "server": "tsx server/index.ts",
    "start": "npm run build && tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run tests/unit tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "tsx tests/e2e/runE2E.ts"
  },
  "dependencies": {
    "three": "^0.172.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/three": "^0.172.0",
    "@types/ws": "^8.5.14",
    "playwright-core": "^1.50.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^2.1.9"
  }
}
